# Copy to .env.local and fill in. Never commit .env.local (it is in .gitignore).

# Database. Local development without any setup: DATABASE_URL="pglite:./.data/dev" (embedded Postgres, migrated and
# seeded on first start). Shared environments: Neon (console → your project → Connect), pooled for the app, direct for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=""
# Google sign-in: Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your production URL).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email sign-in links, sent with Resend (resend.com → API keys). AUTH_EMAIL_FROM must use a domain verified there.
# Development only: send every email to this address instead of the real person. Production ignores it.
# MAIL_TEST_TO="you@example.com"
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="eShareGoal <no-reply@your-domain.com>"

# Encrypts saved Gmail access. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Lets the scheduler call /api/jobs/overdue, and nobody else. Generate with: openssl rand -base64 32
CRON_SECRET=""

# Comma-separated emails that become System Admins (active at once) when the inbox is proven: Google or an email link, never a password sign-up.
ADMIN_EMAILS="you@example.com"

# Developer sign-in on /sign-in: pick anyone in the database, no password. Development only; ignored in production.
AUTH_DEV_LOGIN=false
# Set to false to start the local database empty instead of with the demo seed.
# DEV_SEED=false
# The login toggle. true: skip sign-in and switch people with "View as" in the header (kept until changed). false: sign in like production.
# Development only: production always signs in, whatever this says.
# AUTH_DEV_AS: who you are before switching (a user id, e.g. seed-bernz); default: first System Admin.
AUTH_DEV_BYPASS=false
# AUTH_DEV_AS=seed-bernz
